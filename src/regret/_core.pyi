# action abstraction
class PreflopSizing:
    open_bb: list[float]
    reraise_x_ip: list[float]
    reraise_x_oop: list[float]
    four_bet_x: list[float]
    all_in: bool
    max_raises: int
    def __init__(self) -> None: ...

class PostflopSizing:
    bet_pot: list[float]
    raise_pot: list[float]
    all_in: bool
    max_raises: int
    def __init__(self) -> None: ...

class ActionRules:
    chips_per_bb: int
    preflop: PreflopSizing
    postflop: list[tuple[int, PostflopSizing]]
    def __init__(self) -> None: ...

def abstract_actions(state: HandState, rules: ActionRules) -> list[Action]: ...
